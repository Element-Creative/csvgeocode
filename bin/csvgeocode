#!/usr/bin/env node

// Plain CommonJS on purpose (see bin/package.json), so that older Node
// versions get this message instead of an error about ES modules.
var major = Number(process.versions.node.split(".")[0]);

if (major < 20) {
  console.error("csvgeocode needs Node 20 or newer (this is " + process.version + ").");
  process.exit(1);
}

import("../src/cli.js");
