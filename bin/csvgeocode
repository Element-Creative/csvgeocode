#!/usr/bin/env node

var path = require("path"),
    fs = require("fs"),
    csv = require("dsv")(","),
    yargs = require("yargs")
    .usage("Usage: geocode [options] [input CSV] [output CSV]")
    .demand(["url"])
    .describe("url","[REQUIRED] A URL template to use, with column names from your input CSV surrounded by {{}}. Example: http://mygeocoder.com/?address={{STREET_ADDRESS}}&apiKey=123ABC")
    .describe("lat","Latitude column name. Default: automatic detection")
    .describe("lng","Longitude column name. Default: automatic detection")
    .describe("delay","Milliseconds to wait between API calls. Default: 250")
    .describe("force","Re-geocode every row, even input rows that already have a lat/lng. (To replace an existing output file, use --overwrite.) Can't be resumed")
    .describe("precision","Decimal places to round lat/lng to. Default: 6")
    .describe("overwrite","Replace the output file if it already exists")
    .describe("resume","Continue an interrupted run: rows already geocoded in the output file are kept and skipped")
    .describe("save-every","Save progress to the output file every N rows, so an interrupted run can be resumed. 0 disables. Default: 100")
    .describe("verbose","Show some information while csvgeocode is running")
    .describe("handler","What API handler to use.  Current built-in options are 'mapbox', 'google', and 'tamu'.  Default: 'google'")
    .describe("help","Show this message")
    .boolean(["force","overwrite","resume","verbose","help"])
    .string(["_","lat","lng","url","handler"])
    .check(function(argv) {

      if (argv.help) return;
      if ("delay" in argv && isNaN(Number(argv.delay))) {
        throw new Error("--delay requires a numeric value in milliseconds.");
      }

      if ("precision" in argv && !/^\d+$/.test(argv.precision)) {
        throw new Error("--precision requires a whole number of decimal places.");
      }

      if (argv.resume && argv._.length < 2) {
        throw new Error("--resume requires an output file.");
      }

      if (argv.resume && argv.force) {
        throw new Error("--resume and --force can't be used together: a --force run re-geocodes every row, so there's no way to tell which rows in the output are already done.");
      }

      if (argv.resume && argv.overwrite) {
        throw new Error("--resume and --overwrite can't be used together.");
      }

      if (argv._.length > 1) {

        if (path.resolve(argv._[0]) === path.resolve(argv._[1])) {
          throw new Error("The output file can't be the same as the input file.");
        }

        //Don't clobber a previous (possibly partial) run by accident
        if (fs.existsSync(argv._[1]) && !argv.resume && !argv.overwrite) {
          throw new Error(argv._[1] + " already exists. Add --resume to continue that run, or --overwrite to replace it.");
        }

      }

      if ("save-every" in argv && !/^\d+$/.test(argv["save-every"])) {
        throw new Error("--save-every requires a whole number of rows.");
      }

      return true;

    }),
    args = yargs.argv,
    geocode = require("../"),
    options = require("../src/defaults"),
    geocoder;

if (args.help || !args._ || !args._.length) {
  return yargs.showHelp();
}

if (!args.handler) {
  console.warn("No handler specified, defaulting to Google");
}

for (var key in args) {
  if (args[key] !== undefined) {
    options[key] = ["precision","save-every","saveEvery"].indexOf(key) > -1 ? Number(args[key]) : args[key];
  }
}

//They specified an output file
if (args._.length > 1) {

  geocoder = geocode(args._[0],args._[1],options);

//No output file, use stdout
} else {
  geocoder = geocode(args._[0],options);
}

geocoder.on("error",function(err){
  console.error(err.message);
  process.exit(1);
});

geocoder.on("resume",function(progress){
  if (progress.found) {
    console.warn("Resuming: "+progress.done+" of "+progress.total+" rows already geocoded in "+args._[1]);
  } else {
    console.warn("Nothing to resume: "+args._[1]+" doesn't exist yet. Starting from the beginning.");
  }
});

//On Ctrl-C or kill, save whatever has been geocoded so far before exiting
["SIGINT","SIGTERM"].forEach(function(signal){
  process.on(signal,function(){
    var progress = geocoder.saveProgress && geocoder.saveProgress();
    if (progress) {
      console.warn("\nInterrupted. Saved "+progress.done+" of "+progress.total+" rows to "+args._[1]);
    }
    process.exit(130);
  });
});

if (args.verbose) {

  geocoder.on("row",function(err,row){
      console.warn((err || "SUCCESS")+" | "+csv.formatRows([csv.parseRows(csv.format([row]))[1]]));
    })
    .on("progress",function(progress){
      console.warn("Saved progress: "+progress.done+" of "+progress.total+" rows");
    })
    .on("complete",function(summary){
      console.warn("\nRows geocoded: "+summary.successes+"\n"+
                  "Rows failed: "+summary.failures+"\n"+
                  "Time elapsed: "+(Math.round(summary.time/100)/10)+" seconds");
    });

}
